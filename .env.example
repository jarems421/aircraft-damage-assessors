# Copy to .env.local for local development, and set the same values in Vercel for deployment.
# NEVER commit real keys. .env* is git-ignored.

# --- Enquiry form email (Resend). Sending stays off until RESEND_API_KEY is set. ---
# Create a key at https://resend.com (free tier covers this site's volume).
RESEND_API_KEY=

# Where website enquiries are delivered. Defaults to the published company email.
ENQUIRY_TO=avionicsplus@gmail.com

# Verified sender address. Until a domain is verified in Resend, leave this blank: test sends
# then come from onboarding@resend.dev and can only reach the Resend account owner's address,
# so visitor confirmation emails will not be delivered.
ENQUIRY_FROM=

# --- Optional: send the enquiry through the company's own mail server (cPanel at Safaricom). ---
# The server refuses Resend's servers, so enquiries to @aircraftdamageassessors.com bounce through
# Resend. When these are set, the enquiry is sent through the server logged in as this mailbox, and
# falls back to Resend if that fails. Confirmations still go through Resend.
SMTP_HOST=host56.safaricombusiness.co.ke
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Site address. Setting this also switches on search-engine indexing. ---
# Leave blank for review deployments so they stay out of search results.
NEXT_PUBLIC_SITE_URL=
